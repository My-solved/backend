{
  "name": "solved-proxy",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A credential-safe, allowlisted gateway for the official solved.ac v4 API.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "load:mock": "npm run build --silent && node tool/mock-load.mjs",
    "smoke:live": "node tool/live-smoke.mjs",
    "start": "node dist/src/server.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
