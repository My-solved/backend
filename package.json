{
  "name": "solved-proxy",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A credential-safe, allowlisted gateway for the official solved.ac v4 API.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "load:mock": "npm run build --silent && node tool/mock-load.mjs",
    "openapi:check": "node tool/check-openapi.mjs",
    "openapi:operations:check": "node tool/generate-v4-operation-manifest.mjs --check",
    "openapi:operations:update": "node tool/generate-v4-operation-manifest.mjs",
    "openapi:types:check": "node tool/generate-v4-wire-types.mjs --check && openapi-typescript openapi/solved-v4.openapi.json --alphabetize --output src/generated/solved-v4.openapi.d.ts --check",
    "openapi:types:update": "node tool/generate-v4-wire-types.mjs && openapi-typescript openapi/solved-v4.openapi.json --alphabetize --output src/generated/solved-v4.openapi.d.ts",
    "openapi:update": "node tool/update-openapi.mjs",
    "smoke:live": "node tool/live-smoke.mjs",
    "start": "node dist/src/server.js",
    "test": "npm run openapi:check && npm run openapi:types:check && npm run openapi:operations:check && npm run build && node --test dist/test/*.test.js test/*.test.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}
